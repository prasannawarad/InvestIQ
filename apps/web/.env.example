NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Server routes (`/api/kuber/*`) use `@supabase/ssr` with these same keys plus the user’s cookies to hydrate portfolio/profile context — no SERVICE_ROLE_KEY required for demos.

# Kuber LLM (Person 2) — Groq OpenAI-compatible API
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Kuber Voice — web + extension Speak (voice_id = UUID from ElevenLabs Voices API)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=paste-your-voice-uuid-here
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# App URL used by extension/api integrations
NEXT_PUBLIC_APP_URL=http://localhost:3000
