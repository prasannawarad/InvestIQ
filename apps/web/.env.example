# Kuber LLM (Person 2)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Kuber Voice — extension “Speak” + future web streaming (voice_id = UUID from ElevenLabs Voices API)
